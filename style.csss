body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #f4f6f9;
}

header {
  text-align: center;
  padding: 50px 20px;
  background: #2c3e50;
  color: white;
}

header h1 {
  margin: 0;
  font-size: 32px;
}

header p {
  margin-top: 10px;
  opacity: 0.8;
}

#portfolio {
  max-width: 1000px;
  margin: auto;
  padding: 40px 20px;
}

/* 卡片 */
.card {
  display: flex;
  gap: 20px;
  margin-bottom: 30px;
  background: white;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 6px 20px rgba(0,0,0,0.08);
  transition: 0.3s;
}

.card:hover {
  transform: translateY(-6px);
}

/* 图片 */
.card img {
  width: 300px;
  object-fit: cover;
  cursor: pointer;
}

/* 内容 */
.content {
  padding: 20px;
}

.content h3 {
  margin-bottom: 10px;
}

.content p {
  color: #555;
  line-height: 1.6;
}

/* 按钮 */
.buttons a {
  display: inline-block;
  margin-top: 10px;
  margin-right: 10px;
  padding: 6px 14px;
  background: #2c3e50;
  color: white;
  border-radius: 6px;
  text-decoration: none;
}

.buttons a:hover {
  background: #34495e;
}

/* 底部 */
footer {
  text-align: center;
  padding: 20px;
  color: #888;
}