body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #f5f7fa;
}

/* ===== Hero 区 ===== */
#hero {
  background: linear-gradient(135deg, #2c3e50, #4ca1af);
  color: white;
  padding: 100px 20px;
  text-align: center;
}

.hero-content h1 {
  font-size: 42px;
  margin-bottom: 10px;
}

.subtitle {
  font-size: 18px;
  margin-bottom: 15px;
}

.desc {
  max-width: 600px;
  margin: auto;
  line-height: 1.6;
  margin-bottom: 20px;
}

.hero-buttons a {
  display: inline-block;
  margin: 10px;
  padding: 10px 20px;
  background: white;
  color: #2c3e50;
  border-radius: 6px;
  text-decoration: none;
  font-weight: bold;
}

.hero-buttons a:hover {
  background: #ecf0f1;
}

/* ===== 成果区 ===== */
#portfolio {
  max-width: 1000px;
  margin: auto;
  padding: 50px 20px;
}

#portfolio h2 {
  margin-bottom: 30px;
}

.item {
  display: flex;
  gap: 20px;
  background: white;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 5px 20px rgba(0,0,0,0.08);
  margin-bottom: 25px;
  transition: 0.3s;
}

.item:hover {
  transform: translateY(-5px);
}

.item img {
  width: 300px;
  object-fit: cover;
}

.content {
  padding: 20px;
}

.content p {
  color: #555;
}

.buttons a {
  display: inline-block;
  margin-right: 10px;
  margin-top: 10px;
  padding: 6px 14px;
  background: #2c3e50;
  color: white;
  text-decoration: none;
  border-radius: 6px;
}
